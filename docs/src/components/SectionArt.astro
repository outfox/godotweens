---
// Small illustration that marks which part of the docs a page belongs to. It plays once, then rests.
export type Section = 'curve' | 'hop' | 'catalog' | 'sketch' | 'dock';
interface Props {
	kind: Section;
}
const { kind } = Astro.props;
// Time (s) of each drawing's resting frame: the first moment its motion has settled.
const still: Record<Section, number> = { curve: 2, hop: 1.2, catalog: 1.6, sketch: 2.4, dock: 1.6 };
---

<svg class:list={['art', `art-${kind}`]} data-still={still[kind]} viewBox="0 0 160 100" aria-hidden="true" focusable="false">
	{
		kind === 'curve' && (
			<>
				<path class="grid" d="M10 90H130M10 10H130M10 50H130M130 10V90M10 10V90" />
				<path class="track" d="M10 90C40 90 44 -6 76 8S112 10 130 10" />
				<g class="curve-x">
					<g class="curve-y">
						<circle class="dot mint" r="6" />
					</g>
				</g>
				<line class="axis" x1="146" y1="10" x2="146" y2="90" />
				<g class="curve-y value">
					<circle class="dot blue" cx="146" r="5" />
				</g>
			</>
		)
	}
	{
		kind === 'hop' && (
			<>
				<defs>
					<mask id="hop-lit">
						<path class="hop-mask" d="M28 69Q80 -11 132 69" pathLength="100" stroke-dashoffset="100">
							<animate attributeName="stroke-dashoffset" dur="2.4s" repeatCount="indefinite" values="100;100;0;0;100;100" keyTimes="0;0.12;0.45;0.62;0.95;1" calcMode="spline" keySplines="0 0 1 1;0.45 0 0.55 1;0 0 1 1;0.45 0 0.55 1;0 0 1 1" />
						</path>
					</mask>
				</defs>
				<rect class="pad" x="12" y="80" width="32" height="6" rx="3" />
				<rect class="pad" x="116" y="80" width="32" height="6" rx="3" />
				<path class="trail" d="M28 69Q80 -11 132 69" />
				<g>
					<path class="trail lit" d="M28 69Q80 -11 132 69" mask="url(#hop-lit)" />
					{/* One SMIL clock drives position, trail and squash; the box's bottom rides 11 units under the arc. */}
					<g>
						<animateMotion dur="2.4s" repeatCount="indefinite" path="M28 80Q80 0 132 80" keyPoints="0;0;1;1;0;0" keyTimes="0;0.12;0.45;0.62;0.95;1" calcMode="spline" keySplines="0 0 1 1;0.45 0 0.55 1;0 0 1 1;0.45 0 0.55 1;0 0 1 1" />
						<g>
							<animateTransform attributeName="transform" type="scale" dur="2.4s" repeatCount="indefinite" values="1 1;1 1;1.25 0.75;0.85 1.2;1 1;1 1;1.3 0.7;1 1;1 1;1.25 0.75;0.85 1.2;1 1;1 1;1.3 0.7;1 1" keyTimes="0;0.04;0.1;0.15;0.25;0.43;0.47;0.54;0.56;0.6;0.65;0.75;0.93;0.97;1" />
							<rect class="hopper" x="-11" y="-22" width="22" height="22" rx="6" />
						</g>
					</g>
				</g>
			</>
		)
	}
	{
		kind === 'catalog' && (
			<>
				{[0, 1, 2].map((c) =>
					[0, 1].map((r) => <rect class="cell" x={8 + c * 50} y={6 + r * 46} width="44" height="42" rx="8" />),
				)}
				<g transform="translate(30 27)">
					<circle class="c-move mint-fill" r="6" />
				</g>
				<g transform="translate(80 27)">
					<rect class="c-rotate amber-fill" x="-8" y="-8" width="16" height="16" rx="3" />
				</g>
				<g transform="translate(130 27)">
					<circle class="c-scale blue-fill" r="9" />
				</g>
				<g transform="translate(30 73)">
					<rect class="c-color" x="-10" y="-8" width="20" height="16" rx="4" />
				</g>
				<g transform="translate(80 73)">
					<circle class="c-fade mint-fill" r="9" />
				</g>
				<g transform="translate(130 73)">
					<rect class="c-skew amber-fill" x="-9" y="-9" width="18" height="18" rx="3" />
				</g>
			</>
		)
	}
	{
		kind === 'sketch' && (
			<>
				<defs>
					<mask id="sketch-reveal">
						<path class="sketch-mask" d="M14 82C50 82 48 18 84 18S120 50 146 26" pathLength="100" stroke-dashoffset="100">
							<animate attributeName="stroke-dashoffset" dur="3.2s" repeatCount="indefinite" values="100;0;0" keyTimes="0;0.7;1" calcMode="spline" keySplines="0.16 1 0.3 1;0 0 1 1" />
						</path>
					</mask>
				</defs>
				<path class="sketch-ghost" d="M14 82C50 82 48 18 84 18S120 50 146 26" />
				<path class="sketch-line" d="M14 82C50 82 48 18 84 18S120 50 146 26" mask="url(#sketch-reveal)" />
				<circle class="sketch-tip" r="5">
					<animateMotion dur="3.2s" repeatCount="indefinite" path="M14 82C50 82 48 18 84 18S120 50 146 26" keyPoints="0;1;1" keyTimes="0;0.7;1" calcMode="spline" keySplines="0.16 1 0.3 1;0 0 1 1" />
				</circle>
			</>
		)
	}
	{
		kind === 'dock' && (
			<>
				<rect class="socket" x="96" y="26" width="52" height="48" rx="10" />
				<rect class="socket-hole" x="96" y="40" width="20" height="20" rx="4" />
				<rect class="socket-glow" x="96" y="26" width="52" height="48" rx="10" opacity="0">
					<animate attributeName="opacity" dur="2.8s" repeatCount="indefinite" values="0;0;0.35;0.35;0;0" keyTimes="0;0.33;0.36;0.78;0.84;1" />
				</rect>
				{/* Docked, the pin fills the hole and the body sits flush against the socket (x 96). */}
				<g>
					<animateTransform attributeName="transform" type="translate" dur="2.8s" repeatCount="indefinite" values="-20 0;-20 0;18 0;15 0;18 0;18 0;-20 0" keyTimes="0;0.1;0.34;0.38;0.42;0.8;1" calcMode="spline" keySplines="0 0 1 1;0.7 0 0.9 0.5;0.2 0.6 0.4 1;0.4 0 0.6 1;0 0 1 1;0.45 0 0.55 1" />
					<rect class="plug-body" x="30" y="30" width="48" height="40" rx="10" />
					<rect class="plug-pin" x="78" y="42" width="20" height="16" rx="3" />
				</g>
				<circle class="spark" cx="96" cy="50" r="4" opacity="0">
					<animate attributeName="r" dur="2.8s" repeatCount="indefinite" values="4;4;26;26" keyTimes="0;0.34;0.56;1" calcMode="spline" keySplines="0 0 1 1;0.16 1 0.3 1;0 0 1 1" />
					<animate attributeName="opacity" dur="2.8s" repeatCount="indefinite" values="0;0;1;0;0" keyTimes="0;0.335;0.35;0.56;1" />
				</circle>
			</>
		)
	}
</svg>

<script>
	import { reducedMotion } from '../scripts/motion';

	// Each drawing plays up to its resting frame and holds there; pointing at it plays it again.
	// One clock drives both kinds of motion: SMIL through the SVG, CSS animations through the Web Animations API.
	for (const svg of document.querySelectorAll<SVGSVGElement>('svg.art')) {
		const still = Number(svg.dataset.still ?? 0);
		let timer = 0;
		const seek = (seconds: number, run: boolean) => {
			svg.setCurrentTime(seconds);
			if (run) svg.unpauseAnimations();
			else svg.pauseAnimations();
			for (const a of svg.getAnimations({ subtree: true })) {
				a.currentTime = seconds * 1000;
				if (run) a.play();
				else a.pause();
			}
		};
		const play = () => {
			clearTimeout(timer);
			seek(0, true);
			timer = window.setTimeout(() => seek(still, false), still * 1000);
		};
		if (reducedMotion()) seek(still, false);
		else {
			play();
			svg.addEventListener('pointerenter', play);
		}
	}
</script>

<style>
	.art {
		width: 100%;
		height: auto;
		overflow: visible;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.grid {
		stroke: var(--tw-grid);
		stroke-width: 1;
	}
	.track,
	.trail {
		stroke: var(--tw-track);
		stroke-width: 2.5;
	}
	.trail {
		stroke-dasharray: 2 7;
	}
	.axis {
		stroke: var(--tw-outline);
		stroke-width: 2;
	}
	.dot.mint,
	.mint-fill {
		fill: var(--tw-mint);
	}
	.dot.blue,
	.blue-fill {
		fill: var(--tw-blue);
	}
	.amber-fill {
		fill: var(--tw-amber);
	}

	/* curve: x runs linearly in time, y follows BackOut-ish value, a value dot rides the axis */
	.curve-x {
		animation: curve-x 2.6s linear infinite;
	}
	.curve-y {
		animation: curve-y 2.6s var(--ease-back-out) infinite;
	}
	@keyframes curve-x {
		0% {
			transform: translateX(10px);
		}
		70%,
		100% {
			transform: translateX(130px);
		}
	}
	@keyframes curve-y {
		0% {
			transform: translateY(90px);
		}
		70%,
		100% {
			transform: translateY(10px);
		}
	}

	/* hop: a sprite jumps pad to pad, squashing on each landing */
	.pad {
		fill: var(--tw-raised);
	}
	.hopper {
		fill: var(--tw-amber);
	}
	.trail.lit {
		stroke: var(--tw-amber);
	}
	.hop-mask {
		stroke: #fff;
		stroke-width: 8;
		fill: none;
		stroke-dasharray: 100 100;
	}
	/* catalog: each cell tweens one property */
	.cell {
		fill: color-mix(in oklab, var(--tw-raised) 55%, transparent);
	}
	.art-catalog :is(.c-move, .c-rotate, .c-scale, .c-color, .c-fade, .c-skew) {
		transform-box: fill-box;
		transform-origin: center;
	}
	.c-move {
		animation: c-move 1.6s var(--ease-back-out) infinite alternate;
	}
	.c-rotate {
		animation: c-rotate 2.2s var(--ease-elastic-out) infinite;
	}
	.c-scale {
		animation: c-scale 1.6s var(--ease-bounce-out) infinite alternate;
	}
	.c-color {
		animation: c-color 1.6s var(--ease-smoother-step) infinite alternate;
	}
	.c-fade {
		animation: c-fade 1.6s var(--ease-smoother-step) infinite alternate;
	}
	.c-skew {
		animation: c-skew 1.6s var(--ease-back-out) infinite alternate;
	}
	@keyframes c-move {
		from {
			transform: translateX(-12px);
		}
		to {
			transform: translateX(12px);
		}
	}
	@keyframes c-rotate {
		from {
			transform: rotate(0deg);
		}
		60%,
		to {
			transform: rotate(90deg);
		}
	}
	@keyframes c-scale {
		from {
			transform: scale(0.35);
		}
		to {
			transform: scale(1);
		}
	}
	@keyframes c-color {
		from {
			fill: var(--tw-mint);
		}
		to {
			fill: var(--tw-blue);
		}
	}
	@keyframes c-fade {
		from {
			opacity: 0.12;
		}
		to {
			opacity: 1;
		}
	}
	@keyframes c-skew {
		from {
			transform: skewX(-22deg);
		}
		to {
			transform: skewX(22deg);
		}
	}

	/* sketch: a dashed path still being drawn, for work that is planned */
	.sketch-ghost {
		stroke: var(--tw-outline);
		stroke-width: 2;
		stroke-dasharray: 3 6;
	}
	.sketch-line {
		stroke: var(--tw-amber);
		stroke-width: 3.5;
		stroke-dasharray: 9 7;
	}
	.sketch-mask {
		stroke: #fff;
		stroke-width: 10;
		stroke-dasharray: 100 100;
	}
	.sketch-tip {
		fill: var(--tw-amber);
	}

	/* dock: the plug is pulled in, clicks home with a small recoil, lights the socket, then lets go */
	.socket {
		fill: var(--tw-raised);
	}
	.socket-hole {
		fill: var(--tw-stage);
	}
	.socket-glow {
		fill: var(--tw-mint);
	}
	.plug-body {
		fill: var(--tw-mint);
	}
	.plug-pin {
		fill: var(--tw-blue);
	}
	.spark {
		fill: none;
		stroke: var(--tw-mint);
		stroke-width: 3;
	}

	@media (prefers-reduced-motion: reduce) {
		.curve-x {
			transform: translateX(130px);
		}
		.curve-y {
			transform: translateY(10px);
		}
	}
</style>
