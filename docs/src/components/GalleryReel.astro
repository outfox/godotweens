---
// Contact sheet of the testbed gallery: one CSS vignette per page, named as in the page table.
const pages = [
	{ key: 'squash', name: 'Squash & stretch' },
	{ key: 'choreo', name: 'Choreography' },
	{ key: 'paths', name: 'Motion & paths' },
	{ key: 'ui', name: 'Interface' },
	{ key: 'particles', name: 'Drawing & particles' },
	{ key: 'stage3d', name: '3D stage' },
	{ key: 'materials', name: 'Materials' },
	{ key: 'shaders', name: 'Shaders' },
];
---

<ol class="reel not-content">
	{
		pages.map((p, i) => (
			<li class="tile">
				<div class:list={['vig', p.key]} aria-hidden="true">
					{p.key === 'squash' && (
						<>
							<span class="shadow" />
							<span class="ball" />
						</>
					)}
					{p.key === 'choreo' && [0, 1, 2].map((n) => <span class="card" style={`--n:${n}`} />)}
					{p.key === 'paths' && (
						<>
							<svg viewBox="0 0 160 90">
								<path d="M14 70C50 70 40 18 80 20S120 72 146 26" />
								<rect class="rider" x="-6" y="-6" width="12" height="12" rx="3">
									<animateMotion
										dur="4.8s"
										repeatCount="indefinite"
										rotate="auto"
										path="M14 70C50 70 40 18 80 20S120 72 146 26"
										keyPoints="0;1;0"
										keyTimes="0;0.5;1"
										calcMode="spline"
										keySplines="0.65 0 0.35 1;0.65 0 0.35 1"
									/>
								</rect>
							</svg>
						</>
					)}
					{p.key === 'ui' && (
						<>
							<span class="typed">Loading…</span>
							<span class="bar">
								<span />
							</span>
						</>
					)}
					{p.key === 'particles' && Array.from({ length: 10 }, (_, n) => <span class="spark" style={`--a:${n * 36}deg;--n:${n}`} />)}
					{p.key === 'stage3d' && (
						<span class="cube">
							{['f', 'b', 'l', 'r', 't', 'd'].map((f) => (
								<span class:list={['face', f]} />
							))}
						</span>
					)}
					{p.key === 'materials' && (
						<>
							<span class="orb" />
							<span class="orb" />
						</>
					)}
					{p.key === 'shaders' && <span class="wave" />}
				</div>
				<span class="caption">
					<span class="num">{i}</span> {p.name}
				</span>
			</li>
		))
	}
</ol>

<style>
	.reel {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 2rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 1rem;
	}
	.tile {
		display: grid;
		gap: 0.45rem;
		margin: 0;
	}
	.vig {
		position: relative;
		height: 6.5rem;
		border-radius: 0.9rem;
		background: var(--tw-stage);
		border: 1px solid var(--tw-outline);
		overflow: hidden;
		transition: translate 0.4s var(--ease-back-out);
	}
	.tile:hover .vig {
		translate: 0 -4px;
	}
	.caption {
		font-size: var(--sl-text-sm);
		font-weight: 650;
		color: var(--sl-color-white);
	}
	.num {
		display: inline-grid;
		place-items: center;
		min-width: 1.3rem;
		height: 1.3rem;
		margin-right: 0.2rem;
		border-radius: 0.35rem;
		background: var(--tw-raised);
		font: 700 0.68rem var(--sl-font-mono);
		color: var(--tw-muted);
	}

	/* Squash & stretch */
	.squash .ball {
		position: absolute;
		left: calc(50% - 14px);
		bottom: 14px;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--tw-mint);
		transform-origin: 50% 100%;
		animation: bounce 1.1s infinite;
	}
	.squash .shadow {
		position: absolute;
		left: calc(50% - 18px);
		bottom: 10px;
		width: 36px;
		height: 6px;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.35);
		animation: shadow 1.1s infinite;
	}
	@keyframes bounce {
		0%,
		100% {
			translate: 0 0;
			scale: 1.35 0.7;
			animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
		}
		12% {
			scale: 0.8 1.25;
		}
		50% {
			translate: 0 -58px;
			scale: 1 1;
			animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4);
		}
		88% {
			scale: 0.85 1.2;
		}
	}
	@keyframes shadow {
		0%,
		100% {
			scale: 1.1;
			opacity: 1;
			animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
		}
		50% {
			scale: 0.45;
			opacity: 0.4;
			animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4);
		}
	}

	/* Choreography: staggered card deal with flips */
	.choreo {
		perspective: 400px;
	}
	.card {
		position: absolute;
		left: calc(22% + var(--n) * 22%);
		top: 50%;
		width: 26px;
		height: 38px;
		margin: -19px 0 0 -13px;
		border-radius: 5px;
		background: var(--tw-blue);
		animation: deal 2.8s var(--ease-back-out) infinite;
		animation-delay: calc(var(--n) * 0.14s);
	}
	@keyframes deal {
		0% {
			translate: -120px 40px;
			rotate: y 180deg;
			background: var(--tw-raised-hover);
		}
		30%,
		80% {
			translate: 0 0;
			rotate: y 0deg;
			background: var(--tw-blue);
		}
		100% {
			translate: 120px -40px;
			rotate: y 0deg;
			opacity: 0;
		}
	}

	/* Motion & paths */
	.paths svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: none;
		stroke: var(--tw-track);
		stroke-width: 2;
		stroke-dasharray: 2 5;
	}
	.paths .rider {
		fill: var(--tw-mint);
		stroke: none;
	}

	/* Interface: character reveal and a progress value */
	.ui {
		display: grid;
		align-content: center;
		gap: 0.6rem;
		padding-inline: 1rem;
	}
	.typed {
		font: 700 0.85rem var(--sl-font-mono);
		color: var(--sl-color-white);
		white-space: nowrap;
		overflow: hidden;
		width: 0ch;
		animation: type 2.6s steps(8) infinite;
	}
	@keyframes type {
		0% {
			width: 0ch;
			color: var(--tw-muted);
		}
		60%,
		100% {
			width: 8ch;
			color: var(--tw-amber);
		}
	}
	.ui .bar {
		height: 8px;
		border-radius: 4px;
		background: var(--tw-raised);
		overflow: hidden;
	}
	.ui .bar span {
		display: block;
		height: 100%;
		background: var(--tw-amber);
		transform-origin: 0 50%;
		animation: fillbar 2.6s var(--ease-expo-out) infinite;
	}
	@keyframes fillbar {
		0% {
			scale: 0 1;
			background: var(--tw-blue);
		}
		70%,
		100% {
			scale: 1 1;
			background: var(--tw-mint);
		}
	}

	/* Drawing & particles */
	.spark {
		position: absolute;
		left: 50%;
		top: 55%;
		width: 7px;
		height: 7px;
		margin: -3.5px;
		border-radius: 50%;
		background: var(--tw-amber);
		animation: burst 1.6s var(--ease-expo-out) infinite;
		animation-delay: calc(var(--n) * 0.03s);
	}
	.spark:nth-child(odd) {
		background: var(--tw-mint);
	}
	@keyframes burst {
		0% {
			transform: rotate(var(--a)) translateX(0) scale(1.4);
			opacity: 1;
		}
		80%,
		100% {
			transform: rotate(var(--a)) translateX(42px) translateY(18px) scale(0.3);
			opacity: 0;
		}
	}

	/* 3D stage */
	.stage3d {
		display: grid;
		place-items: center;
		perspective: 300px;
	}
	.cube {
		position: relative;
		width: 36px;
		height: 36px;
		transform-style: preserve-3d;
		animation: spin 3.6s var(--ease-back-out) infinite;
	}
	.face {
		position: absolute;
		inset: 0;
		border-radius: 5px;
		background: color-mix(in oklab, var(--tw-blue) 75%, var(--tw-stage));
		border: 2px solid var(--tw-blue);
	}
	.face.f {
		transform: translateZ(18px);
	}
	.face.b {
		transform: rotateY(180deg) translateZ(18px);
	}
	.face.l {
		transform: rotateY(-90deg) translateZ(18px);
	}
	.face.r {
		transform: rotateY(90deg) translateZ(18px);
	}
	.face.t {
		transform: rotateX(90deg) translateZ(18px);
		background: color-mix(in oklab, var(--tw-mint) 70%, var(--tw-stage));
		border-color: var(--tw-mint);
	}
	.face.d {
		transform: rotateX(-90deg) translateZ(18px);
	}
	@keyframes spin {
		0% {
			transform: rotateX(-24deg) rotateY(0deg);
		}
		50%,
		100% {
			transform: rotateX(-24deg) rotateY(180deg);
		}
	}

	/* Materials: one shared albedo on two meshes */
	.materials {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.4rem;
	}
	.orb {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: radial-gradient(circle at 32% 30%, #fff9 0 10%, transparent 34%), var(--albedo);
		animation: gallery-albedo 2.4s ease-in-out infinite alternate;
	}
	.orb + .orb {
		border-radius: 8px;
	}
	@property --albedo {
		syntax: '<color>';
		inherits: false;
		initial-value: #8caaff;
	}
	@keyframes gallery-albedo {
		from {
			--albedo: #8caaff;
		}
		to {
			--albedo: #f2bc74;
		}
	}

	/* Shaders: a uniform scrolling a procedural pattern */
	.wave {
		position: absolute;
		inset: -20%;
		background: repeating-linear-gradient(
			115deg,
			var(--tw-mint) 0 10px,
			var(--tw-blue) 10px 20px,
			var(--tw-stage) 20px 34px
		);
		opacity: 0.8;
		animation: wave 2.2s linear infinite;
		mask: radial-gradient(closest-side, #000 50%, transparent);
	}
	@keyframes wave {
		to {
			background-position: 37.5px 0;
		}
	}
</style>
