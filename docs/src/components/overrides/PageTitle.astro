---
import SectionArt, { type Section } from '../SectionArt.astro';

const PAGE_TITLE_ID = '_top'; // Starlight's skip-link target

const { id, entry } = Astro.locals.starlightRoute;
const title = entry.data.title;

// One drawing per sidebar group, so the art tells readers which stretch of the path they are on.
const groups: [Section, string[]][] = [
	['dock', ['csharp/installation', 'csharp/quickstart']],
	['hop', ['concepts/definitions', 'csharp/sequences', 'csharp/playback']],
	['curve', ['concepts/easing', 'concepts/timing', 'concepts/lifetime']],
	['catalog', ['csharp/materials', 'csharp/shaders', 'csharp/custom-tweens', 'csharp/api', 'csharp/nodes', 'compatibility']],
	['sketch', ['gdscript']],
];
const section = groups.find(([, ids]) => ids.includes(id))?.[0];

// Letters are split so a hover can ripple through them like a staggered tween list.
let i = 0;
const words = title.split(' ').map((word) => [...word].map((ch) => ({ ch, i: i++ })));
---

<div class="title-row">
	<h1 id={PAGE_TITLE_ID}>
		<span class="sr-only">{title}</span>
		<span class="letters" aria-hidden="true">
			{
				words.map((letters, w) => (
					<>
						{w > 0 && ' '}
						<span class="word">
							{letters.map(({ ch, i }) => (
								<span class="ch" style={`--i:${i}`}>
									{ch}
								</span>
							))}
						</span>
					</>
				))
			}
		</span>
	</h1>
	{
		section && (
			<div class="art">
				<SectionArt kind={section} />
			</div>
		)
	}
</div>

<style>
	.title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: 1rem;
	}
	h1 {
		margin: 0;
		font-size: var(--sl-text-h1);
		line-height: 1.05;
		font-weight: 780;
		font-stretch: 88%;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.word {
		display: inline-block;
		white-space: nowrap;
	}
	.ch {
		display: inline-block;
		transform-origin: 50% 100%;
	}
	/* Titles sit still on load; hovering one sends a hop through its letters. */
	h1:hover .ch {
		animation: hop 0.6s ease-out both;
		animation-delay: calc(var(--i) * 18ms);
	}
	@keyframes hop {
		0% {
			translate: 0 0;
		}
		30% {
			translate: 0 -0.18em;
			scale: 0.96 1.06;
		}
		100% {
			translate: 0 0;
			scale: 1;
		}
	}
	.art {
		flex: 0 0 auto;
		width: clamp(5.5rem, 16vw, 9rem);
	}
	@media (max-width: 30rem) {
		.title-row {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 0.75rem;
		}
		.art {
			width: 5.5rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		h1:hover .ch {
			animation: none;
		}
	}
</style>
