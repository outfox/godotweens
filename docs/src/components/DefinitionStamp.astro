---
// One definition, two independent playbacks; copying the definition with new options leaves running playbacks alone.
---

<div class="tw-widget ds not-content" data-definition-stamp>
	<div class="def" data-def>
		<p class="decl"><span class="kw">var</span> fade = <span class="kw">new</span> <span class="ty">Tweens.ModulateAlpha</span></p>
		<p class="field">To = <output data-to-out>0.0</output></p>
		<p class="field">Duration = <span class="num">2</span></p>
		<label class="tw-field edit">
			<span>Vary <code>fade with &#123; To = … &#125;</code></span>
			<input type="range" min="0" max="1" step="0.1" value="0" data-to />
		</label>
	</div>

	<div class="targets">
		{
			['sprite', 'label'].map((name) => (
				<div class="target" data-target={name}>
					<div class="thing" data-thing>
						{name === 'sprite' ? <span class="sprite" /> : <span class="label">Label</span>}
					</div>
					<button type="button" class="tw-btn" data-start>
						<code>{name}.Tween(fade)</code>
					</button>
					<span class="tw-chip snap" data-snap>
						no playback yet
					</span>
					<span class="meter">
						<span data-meter />
					</span>
				</div>
			))
		}
	</div>
	<div class="foot">
		<button type="button" class="tw-btn" data-reset>Reset alpha</button>
	</div>
</div>

<script>
	import { EASES, animate, loop, lerp, reducedMotion } from '../scripts/motion';

	interface Playback {
		from: number;
		to: number;
		elapsed: number;
	}
	const DURATION = 2;

	for (const root of document.querySelectorAll<HTMLElement>('[data-definition-stamp]')) {
		const def = root.querySelector<HTMLElement>('[data-def]')!;
		const toIn = root.querySelector<HTMLInputElement>('[data-to]')!;
		const toOut = root.querySelector<HTMLOutputElement>('[data-to-out]')!;
		const targets = [...root.querySelectorAll<HTMLElement>('[data-target]')].map((el) => ({
			el,
			thing: el.querySelector<HTMLElement>('[data-thing] > span')!,
			snap: el.querySelector<HTMLElement>('[data-snap]')!,
			meter: el.querySelector<HTMLElement>('[data-meter]')!,
			alpha: 1,
			playback: undefined as Playback | undefined,
		}));

		toIn.addEventListener('input', () => {
			toOut.textContent = Number(toIn.value).toFixed(1);
			animate(toOut, [{ color: 'var(--tw-amber)', scale: 1.3 }, { scale: 1 }], { duration: 400, easing: 'ease-out' });
		});

		// A small token carries the snapshotted value from the definition to the playback's chip.
		const fly = (label: string, to: HTMLElement) => {
			if (reducedMotion()) return;
			const r = root.getBoundingClientRect();
			const a = toOut.getBoundingClientRect();
			const b = to.getBoundingClientRect();
			const token = document.createElement('span');
			token.className = 'stamp-token';
			token.textContent = label;
			root.append(token);
			const x0 = a.left - r.left;
			const y0 = a.top - r.top;
			const dx = b.left + b.width / 2 - token.offsetWidth / 2 - r.left - x0;
			const dy = b.top + b.height / 2 - token.offsetHeight / 2 - r.top - y0;
			token.style.left = `${x0}px`;
			token.style.top = `${y0}px`;
			token
				.animate(
					[
						{ transform: 'translate(0, 0) scale(0.8)', opacity: 0 },
						{ transform: `translate(${dx * 0.5}px, ${dy * 0.5 - 28}px) scale(1)`, opacity: 1, offset: 0.45 },
						{ transform: `translate(${dx}px, ${dy}px) scale(0.9)`, opacity: 0 },
					],
					{ duration: 560, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
				)
				.finished.then(() => {
					token.remove();
					to.animate([{ scale: 0.8 }, { scale: 1 }], { duration: 420, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' });
				});
		};

		targets.forEach((t) =>
			t.el.querySelector('[data-start]')!.addEventListener('click', () => {
				// Starting snapshots the definition; From is the value captured now.
				const to = Number(toIn.value);
				t.playback = { from: t.alpha, to, elapsed: 0 };
				t.snap.textContent = `snapshot: To = ${to.toFixed(1)}`;
				fly(`To = ${to.toFixed(1)}`, t.snap);
				if (reducedMotion()) {
					t.playback.elapsed = DURATION;
				}
			}),
		);
		root.querySelector('[data-reset]')!.addEventListener('click', () =>
			targets.forEach((t) => {
				t.playback = undefined;
				t.alpha = 1;
				t.snap.textContent = 'no playback yet';
			}),
		);

		loop(root, (_, dt) => {
			for (const t of targets) {
				if (t.playback) {
					const p = t.playback;
					p.elapsed = Math.min(DURATION, p.elapsed + dt);
					t.alpha = lerp(p.from, p.to, EASES.SmoothStep(p.elapsed / DURATION));
					t.meter.style.scale = `${p.elapsed / DURATION} 1`;
				} else {
					t.meter.style.scale = '0 1';
				}
				t.thing.style.opacity = String(Math.max(0.04, t.alpha));
			}
		});
	}
</script>

<style>
	.ds {
		position: relative;
		padding: 1.25rem;
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 40rem) {
		.ds {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
			align-items: center;
		}
		.foot {
			grid-column: 1 / -1;
		}
	}
	.def {
		padding: 1rem;
		border-radius: 0.9rem;
		background: var(--tw-surface);
		border: 1px solid var(--tw-outline);
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		display: grid;
		gap: 0.2rem;
	}
	.decl {
		color: var(--sl-color-white);
	}
	.field {
		padding-left: 1.2rem;
	}
	.field output {
		display: inline-block;
		color: var(--tw-amber-ink);
		font-weight: 700;
	}
	.kw {
		color: var(--tw-blue-ink);
	}
	.ty {
		color: var(--tw-mint-ink);
	}
	.num {
		color: var(--tw-amber-ink);
	}
	.edit {
		margin-top: 0.75rem;
		font-family: var(--sl-font);
	}
	.targets {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.target {
		display: grid;
		justify-items: center;
		gap: 0.6rem;
	}
	.thing {
		display: grid;
		place-items: center;
		width: 100%;
		height: 5.5rem;
		border-radius: 0.8rem;
		background:
			conic-gradient(var(--tw-raised) 25%, transparent 0 50%, var(--tw-raised) 0 75%, transparent 0) 0 0 / 14px 14px,
			var(--tw-surface);
	}
	.sprite {
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 0.6rem;
		background: var(--tw-mint);
	}
	.label {
		font-family: var(--tw-font-display);
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--sl-color-white);
	}
	.target .tw-btn code {
		font-size: 0.72rem;
		background: none;
		color: inherit;
	}
	.snap {
		font-size: 0.66rem;
	}
	.meter {
		width: 100%;
		height: 3px;
		border-radius: 2px;
		background: var(--tw-outline);
		overflow: hidden;
	}
	.meter span {
		display: block;
		height: 100%;
		background: var(--tw-mint);
		transform-origin: 0 50%;
		scale: 0 1;
	}
	.ds :global(.stamp-token) {
		position: absolute;
		z-index: 1;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--tw-amber);
		color: #231705;
		font: 700 0.7rem var(--sl-font-mono);
		white-space: nowrap;
		pointer-events: none;
	}
</style>
